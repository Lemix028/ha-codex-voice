# Copy outside Git to /etc/computer-voice/bridge.env, root-owned mode 0600.
HA_CODEX_BRIDGE_TOKEN=REPLACE_WITH_A_UNIQUE_LONG_RANDOM_TOKEN
HA_CODEX_BRIDGE_HOST=127.0.0.1
HA_CODEX_BRIDGE_PORT=8787
# If needed, select the actual native CLI path (preserving all hardened args):
# HA_CODEX_BINARY=/usr/local/bin/codex
# No realtime device token is needed for the Echo Assist pipeline.
