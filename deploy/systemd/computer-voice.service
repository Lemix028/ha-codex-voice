[Unit]
Description=Computer Voice isolated Codex Conversation bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=computer-voice
Group=computer-voice
WorkingDirectory=/opt/computer-voice
EnvironmentFile=/etc/computer-voice/bridge.env
Environment=HA_CODEX_AUTH_FILE=/var/lib/computer-voice/.codex/auth.json
ExecStart=/opt/computer-voice/.venv/bin/python -m bridge
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
StateDirectory=computer-voice
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=2G
CPUQuota=100%

[Install]
WantedBy=multi-user.target
